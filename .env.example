# ========================================================
# AGENDAMENTO SAAS - VARIÁVEIS DE AMBIENTE (EXEMPLO)
# ========================================================

# Supabase / PostgreSQL Connection String (Transaction Pooler - Porta 6543)
# Copie do Supabase: Project Settings > Database > Connection String > URI (Mode: Transaction)
DATABASE_URL="postgresql://postgres.[SEU-PROJECT-REF]:[SUA-SENHA-SUPABASE]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Direct Connection (Session Mode - Porta 5432)
# Copie do Supabase: Project Settings > Database > Connection String > URI (Mode: Session)
DIRECT_URL="postgresql://postgres:[SUA-SENHA-SUPABASE]@db.[SEU-PROJECT-REF].supabase.co:5432/postgres"

# Gateway de Pagamento Global (Opcional - Fallback da plataforma)
# As credenciais individuais dos lojistas são salvas na tabela Tenant no banco
MERCADOPAGO_ACCESS_TOKEN=""

# URL Base da Aplicação (Local ou Vercel)
NEXT_PUBLIC_APP_URL="https://seu-dominio.vercel.app"
